                          className={`ml-0.5 px-1.5 py-0.2 rounded-full text-[10.5px] font-extrabold tabular-nums transition ${
                            isActive
                              ? 'bg-amber-400 text-slate-950'
                              : 'bg-slate-200/90 text-slate-600 group-hover:bg-slate-300/80'
                          }`}
                        >
                          {count}
                        </span>
                      )}
                    </button>
                  );
                })}
              </nav>

              {/* 기본설정 오른쪽에 별도로 분리된 [엠즈 매입/판매가] 사각 탭 버튼 */}
              <div className="bg-slate-100/90 p-1 rounded-xl border border-slate-200/80">
                <button
                  type="button"
                  onClick={() => setActiveTab('MS_PRICE')}
                  className={`group relative flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg text-xs font-extrabold transition-all duration-150 ${
                    activeTab === 'MS_PRICE'
                      ? 'bg-slate-900 text-white shadow-sm ring-1 ring-slate-900/10'
                      : 'text-slate-600 hover:text-slate-900 hover:bg-white/70'
                  }`}
                >
                  <span className="text-sm leading-none">✅</span>
                  <span>엠즈 매입/판매가</span>
                  <span
                    className={`ml-0.5 px-1.5 py-0.2 rounded-full text-[10.5px] font-extrabold tabular-nums transition ${
                      activeTab === 'MS_PRICE'
                        ? 'bg-amber-400 text-slate-950'
                        : 'bg-slate-200/90 text-slate-600 group-hover:bg-slate-300/80'
                    }`}
                  >
                    {pkCostRows.length}
                  </span>
                </button>
              </div>
            </div>
          </div>

          {/* 우측: 구글 시트 동기화 상태 & 액션 버튼 */}
          <div className="flex items-center gap-2 text-xs">
            <div className="hidden sm:flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-slate-100 border border-slate-200/80 text-[11px] font-semibold text-slate-600">
              <span
                className={`w-2 h-2 rounded-full ${
                  syncStatus === 'SAVING' || syncStatus === 'LOADING'
                    ? 'bg-amber-400 animate-ping'
                    : syncStatus === 'ERROR'
                      ? 'bg-rose-500'
                      : 'bg-emerald-500'
                }`}
              />
              <span>
                {syncStatus === 'SAVING'
                  ? '시트 저장 중...'
                  : syncStatus === 'LOADING'
                    ? '동기화 중...'
                    : lastSyncedAt
                      ? `동기화: ${lastSyncedAt}`
                      : '구글시트 연동됨'}
              </span>
            </div>

            <button
              type="button"
              onClick={() => handleLoadFromGoogleSheet(false)}
              disabled={syncStatus === 'LOADING' || syncStatus === 'SAVING'}
              className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 font-bold shadow-2xs transition disabled:opacity-50"
            >
              <span>🔄</span>
              <span>불러오기</span>
            </button>
            <button
              type="button"
              onClick={handleSaveToGoogleSheet}
              disabled={syncStatus === 'LOADING' || syncStatus === 'SAVING'}
              className="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-extrabold shadow-sm shadow-emerald-600/20 transition disabled:opacity-50"
            >
              <span>💾</span>
              <span>구글시트 저장</span>
            </button>
          </div>
        </div>
      </header>

      {/* 토스트 알림 */}
      {toastMessage && (
        <div className="fixed bottom-4 right-4 z-50 bg-slate-900 text-white px-4 py-2.5 rounded-xl shadow-lg text-xs font-bold border border-slate-700">
          {toastMessage}
        </div>
      )}

      {/* 본문 영역 */}
      <main className="flex-1 p-3 sm:p-4 max-w-[1920px] w-full mx-auto">
        {activeTab === 'BASIC_DB' && renderBasicSettingsSheet()}
        {activeTab === 'PK_MAIN' && renderPkMainCostSheet()}
        {activeTab === 'MS_PRICE' && renderMsPriceSheet()}
        {activeTab === 'PIE' && renderProcessCategorySheet('PIE')}
        {activeTab === 'DOUGH' && renderProcessCategorySheet('DOUGH')}
        {activeTab === 'PARBAKE' && renderProcessCategorySheet('PARBAKE')}
        {activeTab === 'BAKERY' && renderProcessCategorySheet('BAKERY')}
      </main>
    </div>
  );
}
