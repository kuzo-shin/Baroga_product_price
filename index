  const renderMsPriceSheet = () => {
    // PK단위 원가표와 동일한 섹션 그룹화 정렬
    const sectionOrder = [];
    const groupedBySection = new Map();

    pkCostRows.forEach((row) => {
      const secName = (row.section || '기타').trim() || '기타';
      if (!groupedBySection.has(secName)) {
        groupedBySection.set(secName, []);
        sectionOrder.push(secName);
      }
      groupedBySection.get(secName).push(row);
    });

    const tableRows = [];
    let seq = 0;

    sectionOrder.forEach((secName) => {
      const rows = groupedBySection.get(secName) || [];
      tableRows.push(
        <tr key={`ms-sec-${secName}`} className="bg-slate-100 border-y border-slate-300">
          <td
            colSpan={9}
            className="py-1.5 px-4 text-center text-xs font-extrabold text-slate-800 tracking-wide"
          >
            ── {secName} ──
          </td>
        </tr>
      );

      rows.forEach((row) => {
        seq += 1;
        const matchedDb = laborDbByProductName.findMatch(row.productName);
        const pkQuantityEa = matchedDb ? Number(matchedDb.pkQuantityEa) || 0 : 0;
        const releasePriceEa = Number(row.releasePriceEa) || 0;
        // 출고가(pk) = 출고가(ea) * pk입수량
        const releasePricePk =
          releasePriceEa > 0 && pkQuantityEa > 0 ? releasePriceEa * pkQuantityEa : null;

        const msBuyPricePk = Number(row.msBuyPricePk) || 0;
        const msSellPricePk = Number(row.msSellPricePk) || 0;

        // 1. 매입가 오차 (%) = (엠즈 매입가(pk) - 바로가 출고가(pk)) / 바로가 출고가(pk)
        const buyPriceErrorRate =
          releasePricePk !== null && releasePricePk > 0 && msBuyPricePk > 0
            ? (msBuyPricePk - releasePricePk) / releasePricePk
            : null;

        // 2. 판매 수수료 (%) = (엠즈 판매가(pk) - 엠즈 매입가(pk)) / 엠즈 매입가(pk)
        const salesFeeRate =
          msBuyPricePk > 0 && msSellPricePk > 0
            ? (msSellPricePk - msBuyPricePk) / msBuyPricePk
            : null;

        const tipReleasePk = {
          title: '바로가 출고가 (pk)',
          formula: '바로가 출고가(ea) × PK입수량(ea)',
          calc:
            releasePricePk !== null
              ? `${fmtInt(releasePriceEa)}원 × ${fmtQty(pkQuantityEa)}ea = ${fmtInt(releasePricePk)}원`
              : 'PK단위 원가표에서 바로가 출고가를 입력하면 자동 계산됩니다.',
        };

        const tipBuyError = {
          title: '매입가 오차 (%)',
          formula: '(엠즈 매입가(pk) - 바로가 출고가(pk)) ÷ 바로가 출고가(pk)',
          calc:
            buyPriceErrorRate !== null
              ? `(${fmtInt(msBuyPricePk)}원 - ${fmtInt(releasePricePk)}원) ÷ ${fmtInt(releasePricePk)}원 = ${(buyPriceErrorRate * 100).toFixed(2)}% (${msBuyPricePk - releasePricePk >= 0 ? '+' : ''}${fmtInt(msBuyPricePk - releasePricePk)}원)`
              : '바로가 출고가(ea)와 엠즈 매입가(pk)가 모두 입력되면 계산됩니다.',
        };

        const tipSalesFee = {
          title: '판매 수수료 (%)',
          formula: '(엠즈 판매가(pk) - 엠즈 매입가(pk)) ÷ 엠즈 매입가(pk)',
          calc:
            salesFeeRate !== null
              ? `(${fmtInt(msSellPricePk)}원 - ${fmtInt(msBuyPricePk)}원) ÷ ${fmtInt(msBuyPricePk)}원 = ${(salesFeeRate * 100).toFixed(2)}% (차액 ${fmtInt(msSellPricePk - msBuyPricePk)}원)`
              : '엠즈 매입가(pk)와 판매가(pk)를 입력하면 자동 계산됩니다.',
        };

        // 오차 강조 색상 (0.05%p 이상 차이 발생 시 시각 강조)
        const buyErrorAlert =
          buyPriceErrorRate !== null && Math.abs(buyPriceErrorRate * 100) >= 0.05;

        tableRows.push(
          <tr
            key={`ms-row-${row.id}`}
            className="border-b border-slate-200 hover:bg-slate-50/90 transition-colors"
          >
            {/* 1. 제품명 (PK단위 원가표 그대로 연동) */}
            <td className="py-1.5 px-2 text-left text-xs font-normal text-slate-900 bg-white border-r border-slate-200 truncate">
              <span className="inline-block w-5 text-[11px] text-slate-400 tabular-nums">
                {seq}.
              </span>
              {row.productName}
            </td>

            {/* 2. pk입수량 (PK단위 원가표 그대로 연동) */}
            <td className="py-1.5 px-2 text-right text-[13.5px] font-normal text-slate-900 bg-white border-r border-slate-200 tabular-nums">
              {pkQuantityEa > 0 ? fmtQty(pkQuantityEa) : ''}
            </td>

            {/* 3. 바로가 출고가 (ea) (PK단위 원가표 그대로 연동) */}
            <td className="py-1.5 px-2 text-right text-[13.5px] font-normal text-slate-900 bg-white border-r border-slate-200 tabular-nums">
              {releasePriceEa > 0 ? fmtInt(releasePriceEa) : ''}
            </td>

            {/* 4. 바로가 출고가 (pk) = 출고가(ea) * pk입수량 */}
            <td
              onMouseEnter={(e) => showFormulaTooltip(e, tipReleasePk)}
              onMouseLeave={hideFormulaTooltip}
              className="py-1.5 px-2 text-right text-[13.5px] font-normal text-slate-900 bg-white border-r border-slate-200 tabular-nums cursor-help hover:bg-slate-50"
            >
              {releasePricePk !== null ? fmtInt(releasePricePk) : ''}
            </td>

            {/* 5. 엠즈 매입가 (pk) - 수기 입력 */}
            <td className="py-1 px-1.5 bg-slate-100/80 hover:bg-slate-200/60 border-r border-slate-200 transition-colors">
              <CommaNumberInput
                value={!row.msBuyPricePk ? '' : row.msBuyPricePk}
                allowEmpty
                placeholder="입력"
                onChangeValue={(val) =>
                  handleUpdatePkRow(row.id, 'msBuyPricePk', val === '' ? 0 : val)
                }
                className="w-full text-right text-[13.5px] font-bold text-blue-700 bg-transparent focus:outline-none focus:bg-white focus:ring-1 focus:ring-blue-500 rounded px-1 py-0.5 tabular-nums"
              />
            </td>

            {/* 6. 엠즈 판매가 (pk) - 수기 입력 */}
            <td className="py-1 px-1.5 bg-slate-100/80 hover:bg-slate-200/60 border-r border-slate-200 transition-colors">
              <CommaNumberInput
                value={!row.msSellPricePk ? '' : row.msSellPricePk}
                allowEmpty
                placeholder="입력"
                onChangeValue={(val) =>
                  handleUpdatePkRow(row.id, 'msSellPricePk', val === '' ? 0 : val)
                }
                className="w-full text-right text-[13.5px] font-bold text-blue-700 bg-transparent focus:outline-none focus:bg-white focus:ring-1 focus:ring-blue-500 rounded px-1 py-0.5 tabular-nums"
              />
            </td>

            {/* 7. 매입가 오차 (%) */}
            <td
              onMouseEnter={(e) => showFormulaTooltip(e, tipBuyError)}
              onMouseLeave={hideFormulaTooltip}
              className={`py-1.5 px-2 text-right text-[13.5px] font-normal border-r border-slate-200 tabular-nums cursor-help ${
                buyErrorAlert
                  ? 'bg-rose-50 text-rose-700'
                  : 'bg-white text-slate-900 hover:bg-slate-50'
              }`}
            >
              {buyPriceErrorRate !== null
                ? `${buyPriceErrorRate > 0 ? '+' : ''}${(buyPriceErrorRate * 100).toFixed(2)}%`
                : ''}
            </td>

            {/* 8. 판매 수수료 (%) */}
            <td
              onMouseEnter={(e) => showFormulaTooltip(e, tipSalesFee)}
              onMouseLeave={hideFormulaTooltip}
              className="py-1.5 px-2 text-right text-[13.5px] font-normal text-slate-900 bg-white border-r border-slate-200 tabular-nums cursor-help hover:bg-slate-50"
            >
              {salesFeeRate !== null ? `${(salesFeeRate * 100).toFixed(2)}%` : ''}
            </td>

            {/* 9. 비고 (수기 가격변동 내역 등 입력) */}
            <td className="py-1 px-1.5 bg-white">
              <input
                type="text"
